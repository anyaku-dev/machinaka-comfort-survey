{
  "name": "machinaka-comfort-survey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "master:sql": "node --no-warnings scripts/generate-master-sql.mjs",
    "master:check": "node --no-warnings scripts/generate-master-sql.mjs --check && node --no-warnings scripts/generate-master-doc.mjs --check",
    "db:start": "supabase start -x studio,imgproxy,mailpit,postgres-meta,vector,logflare,supavisor,realtime,storage-api,edge-runtime",
    "db:reset": "supabase db reset",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run master:check",
    "master:doc": "node --no-warnings scripts/generate-master-doc.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.1.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
